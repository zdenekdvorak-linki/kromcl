# Zkopiruj na .env a doplň klíč. Soubor .env je v .gitignore, tenhle NE.
# Klíč nikdy nepiš sem — tenhle soubor se commituje.
# Klíč se zakládá na https://console.anthropic.com → API keys.

ANTHROPIC_API_KEY=

# Jen když je klíč založený na úrovni organizace, ne uvnitř workspace.
# Poznáš to podle chyby "not scoped to a workspace".
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Volitelné. Backend: api (výchozí) | cli | stub
# KROMKA_BACKEND=api

# Volitelné. Adresa webu, plní se do odkazů, RSS a sitemapy.
# KROMKA_SITE_URL=https://kromcl.cz
